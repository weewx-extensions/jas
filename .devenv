# Bootstrap: the shared settings live in the development-tools checkout.
WEEWX_TOOL_PATH=${WEEWX_TOOL_PATH:-$HOME/weewx_code/weewx-extensions/development-tools/tools}
. "${WEEWX_TOOL_PATH}/devenv.sh"

export WEEWX_MODULE_NAME=jas

# weewx is a sibling checkout here, not installed into the pyenv environment.
export WEEWX_PYTHONPATH=bin:../weewx/src

export WEEWX_LINT_PATHS='./bin/user/jas.py ./bin/user/jas_templates.py'

# Report the lint findings instead of failing, the workflow's lint-fail input.
export WEEWX_LINT_FAIL=0
